{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "server.ts",
        "database/**/*.ts",
        "db/**/*.ts",
        "data/**/*.ts",
        "routes/**/*.ts",
        "config/**/*.ts",
        "utils/**/*.ts",
        "types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
    ]
}