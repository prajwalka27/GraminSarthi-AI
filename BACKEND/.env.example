PORT=5000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/graminsarthi

# =============================================================================
# REAL SMS OTP PROVIDER CONFIGURATION
# Set SMS_PROVIDER to 'twilio' (recommended) or 'msg91'
# =============================================================================
SMS_PROVIDER=twilio

# Twilio Verify Configuration (Recommended for Global & Indian SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# MSG91 Configuration (Alternative Indian Domestic SMS Gateway)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Authentication Session Secret
AUTH_SECRET=your_32_character_secret_key_here
